<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LocalTests>$(MSBuildThisFileDirectory)../../local/tests/</LocalTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <ProjectReference Include="../../src/FlaUI.Mcp.Te3/FlaUI.Mcp.Te3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core's fake desktop, linked (not copied) so it stays Core's; the contract tests below run on it. -->
    <Compile Include="../FlaUI.Mcp.Tests/FakeDesktop.cs" Link="Core/FakeDesktop.cs" />
    <!-- Core's manual clock: the TE3 fake desktop's Time, moved by its Pause, so no Core wait sleeps for real. -->
    <Compile Include="../FlaUI.Mcp.Tests/ManualTimeProvider.cs" Link="Core/ManualTimeProvider.cs" />
    <Compile Include="../FlaUI.Mcp.Tests/Eventually.cs" Link="Core/Eventually.cs" />
    <!-- Core's contract tests of the shared guard, refusals, proofs and the required hook, run in this host too. -->
    <Compile
      Include="../FlaUI.Mcp.Tests/Contract/*.cs"
      Link="Core/Contract/%(Filename)%(Extension)"
    />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeLocalRecipes)' == 'true' And Exists('$(LocalTests)')">
    <Compile Include="$(LocalTests)**/*.cs" Link="local/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
